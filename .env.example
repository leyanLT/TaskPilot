# TaskPilot 环境配置示例
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，切勿提交真实密钥。
# 注意：只有 VITE_ 前缀的变量会暴露给浏览器，API Key 绝不能使用 VITE_ 前缀。

# ---- 后端 / 应用 ----
ENVIRONMENT=development
APP_TIMEZONE=Asia/Shanghai
# 本地从 backend/ 目录启动时，数据库位于 backend/data/taskpilot.db
DATABASE_URL=sqlite:///./data/taskpilot.db
# 启动时自动备份旧库并执行 Alembic 迁移
DATABASE_AUTO_MIGRATE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- DeepSeek / LangGraph Agent ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_RETRIES=1
AGENT_RECURSION_LIMIT=10
PENDING_ACTION_TTL_MINUTES=30

# ---- 前端（本地开发 / 构建时）----
VITE_API_BASE_URL=/api
VITE_APP_TIMEZONE=Asia/Shanghai
